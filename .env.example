EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_LOCALE=en-US
EBAY_CURRENCY=USD

# Required before publishing live offers.
EBAY_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=

# Athletic Shoes category. Validate before publishing.
EBAY_DEFAULT_CATEGORY_ID=15709
EBAY_DEFAULT_CONDITION=USED_EXCELLENT

# Required for Production keyset compliance.
# Use the exact HTTPS URL you enter in eBay Developer Portal.
EBAY_ACCOUNT_DELETION_ENDPOINT=
# 32-80 chars; use the same value in eBay Developer Portal.
EBAY_ACCOUNT_DELETION_VERIFICATION_TOKEN=
